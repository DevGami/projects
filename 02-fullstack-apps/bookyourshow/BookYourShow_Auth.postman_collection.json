{
  "info": {
    "_postman_id": "c8f9a2d1-4b3e-4f1a-9c8b-7e6d5a4b3c2d",
    "name": "BookYourShow - Auth Module",
    "description": "Authentication module endpoints for BookYourShow API. Includes auto-token extraction and collection-level Bearer authorization handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically attach Authorization header for authenticated endpoints",
          "const authRequiredPaths = ['/logout', '/me'];",
          "const currentPath = pm.request.url.getPath();",
          "",
          "if (authRequiredPaths.some(path => currentPath.includes(path))) {",
          "    const token = pm.collectionVariables.get('accessToken');",
          "    if (token) {",
          "        pm.request.headers.upsert({",
          "            key: 'Authorization',",
          "            value: `Bearer ${token}`",
          "        });",
          "    } else {",
          "        console.warn('Authenticated endpoint requested, but accessToken variable is empty. Please login first.');",
          "    }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@demo.com\",\n  \"password\": \"test123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "signup"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is successful (200/201)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test(\"Extract and save accessToken to collection variables\", function () {",
              "    const responseData = pm.response.json();",
              "    // Checks standard token locations: { accessToken }, { token }, or { data: { accessToken } }",
              "    const token = responseData.accessToken || responseData.token || (responseData.data && responseData.data.accessToken);",
              "    ",
              "    if (token) {",
              "        pm.collectionVariables.set(\"accessToken\", token);",
              "        console.log(\"Successfully extracted and stored accessToken:\", token);",
              "    } else {",
              "        console.warn(\"Could not find accessToken in login response body.\");",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@demo.com\",\n  \"password\": \"test123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
