# ═══════════════════════════════════════════════════════════════
# BookYourShow — Environment Variables
# Copy this to .env and fill in real values
# ═══════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
API_PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://bookyourshow:bys_dev_2026@localhost:5432/bookyourshow

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://bookyourshow:bys_dev_2026@localhost:27017/bookyourshow?authSource=admin

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:bys_dev_2026@localhost:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=bys_access_secret_change_in_production_2026
JWT_REFRESH_SECRET=bys_refresh_secret_change_in_production_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── TMDB ─────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ── Groq (RAG LLM) ──────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Email (JavaMail — Notification Service) ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
