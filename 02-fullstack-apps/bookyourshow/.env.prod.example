# ════════════════════════════════════════════════════════════════════════════
# BookYourShow — Production Environment Template
# Copy to .env.prod and fill in real values. NEVER commit .env.prod to git.
# ════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=bookyourshow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bookyourshow
DATABASE_URL=postgresql://bookyourshow:CHANGE_ME_STRONG_PASSWORD@postgres:5432/bookyourshow

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USER=bookyourshow
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_DB=bookyourshow
MONGODB_URI=mongodb://bookyourshow:CHANGE_ME_STRONG_PASSWORD@mongodb:27017/bookyourshow?authSource=bookyourshow

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── API URLs ─────────────────────────────────────────────────────────────────
API_PORT=5000
API_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092

# ── TMDB ─────────────────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# ── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_YOUR_GROQ_KEY

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=BookYourShow
SMTP_FROM_EMAIL=noreply@bookyourshow.com

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
